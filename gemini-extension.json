{
  "name": "agiflow",
  "version": "0.3.1",
  "description": "Access Agiflow tools directly from Gemini CLI.",
  "mcpServers": {
    "agiflow-ai-plugin": {
      "command": "sh",
      "args": [
        "-c",
        "exec npx mcp-remote@latest \"${AGIFLOW_AI_PLUGIN_MCP_URL:-https://agiflow.io/api/v1/mcp-app}\" --header \"x-agiflow-mcp-consumer:plugin\""
      ]
    }
  },
  "contextFileName": "GEMINI.md",
  "settings": [
    {
      "name": "Agiflow MCP URL",
      "description": "Agiflow MCP endpoint URL.",
      "envVar": "AGIFLOW_AI_PLUGIN_MCP_URL"
    }
  ]
}
